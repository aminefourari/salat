{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "salat",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "src/server.ts",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"triggers": { "crons": ["* * * * *"] },
	"d1_databases": [
		{ "binding": "DB", "database_name": "salat", "database_id": "14fcfca9-2dd2-47c4-9242-d7790272d0a0", "migrations_dir": "migrations" }
	],
	"vars": {
		"VAPID_PUBLIC_KEY": "BIjHbRVBp2kI6TBpgMgz2WAM-6Pkn_x-sgPQFyHB4UeS4qTPv3HoC7iJ9blzaRehHKq9CiJPdMKoqUwjg0dN2y8",
		"VAPID_SUBJECT": "https://salat.aminethewiz18.workers.dev"
	}
}